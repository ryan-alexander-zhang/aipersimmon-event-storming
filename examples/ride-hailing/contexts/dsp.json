      "properties": {
        "description": "When a ride is requested, match a driver.",
        "condition": "a driver is available within the search radius",
        "execution": "automatic",
        "parameters": [
          {
            "name": "searchRadius",
            "value": "3km"
          },
          {
            "name": "offerTimeout",
            "value": "30s"
          }
        ]
      }
    },
    {
      "id": "dsp-p-redecline",
      "type": "policy",
      "label": "Re-match on Decline Policy",
      "properties": {
        "condition": "decline attempts for this ride < maxAttempts",
        "execution": "automatic",
        "parameters": [
          {
            "name": "maxAttempts",
            "value": "5"
          },
          {
            "name": "radiusStep",
            "value": "1km"
          }
        ]
      }
    },
    {
      "id": "dsp-p-retimeout",
      "type": "policy",
